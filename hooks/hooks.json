{
  "description": "chrono: instala el binario la primera vez, crea/actualiza el índice al empezar la sesión, avisa al modelo de los logs indexados y, si existe .chrono/intermediario.json, hace de intermediario (resume salidas grandes de MCP y lecturas de ficheros de datos grandes con cifras exactas).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/claude/session-start.sh\"",
            "timeout": 120
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/claude/log-hint.sh\" UserPromptSubmit",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*(grafana|loki|datadog|elastic|opensearch|splunk|newrelic|signoz|observ).*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/claude/log-hint.sh\" PostToolUse",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/claude/intermediario.py\" post",
            "timeout": 90
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/claude/intermediario.py\" read",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
