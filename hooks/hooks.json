{
  "description": "chrono: instala el binario la primera vez, crea/actualiza el índice al empezar la sesión, avisa al modelo de los logs indexados y, si existe .chrono/intermediario.json, hace de intermediario (resume salidas grandes de MCP y lecturas de ficheros de datos grandes con cifras exactas); al terminar, avisa una vez si la respuesta da conteos que no salen de ninguna salida de chrono.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/claude/session-start.sh\"",
            "timeout": 120
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/claude/log-hint.sh\" UserPromptSubmit",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*(grafana|loki|datadog|elastic|opensearch|splunk|newrelic|signoz|observ).*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/claude/log-hint.sh\" PostToolUse",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/claude/hook.sh\" post",
            "timeout": 90
          }
        ]
      },
      {
        "matcher": "Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/claude/hook.sh\" after-read",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/claude/hook.sh\" read",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/claude/hook.sh\" stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
